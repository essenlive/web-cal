{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "web-cal AI-drafted settings import",
  "description": "Shape an AI must return after the prompt in docs/ai-rules-prompt.md — the same envelope web-cal's settings export/import uses (see src/lib/settings-export.ts), restricted to the four sections this feature touches: display types, rules, presets and themes.",
  "type": "object",
  "required": [
    "version",
    "exportedAt",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "overcal:event-types": {
          "type": "object",
          "required": [
            "state",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "number"
            },
            "state": {
              "type": "object",
              "required": [
                "types"
              ],
              "additionalProperties": false,
              "properties": {
                "types": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/$defs/eventType"
                  }
                }
              }
            }
          }
        },
        "overcal:rules": {
          "type": "object",
          "required": [
            "state",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "number"
            },
            "state": {
              "type": "object",
              "required": [
                "rules"
              ],
              "additionalProperties": false,
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/rule"
                  }
                }
              }
            }
          }
        },
        "overcal:presets": {
          "type": "object",
          "required": [
            "state",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "number"
            },
            "state": {
              "type": "object",
              "required": [
                "presets"
              ],
              "additionalProperties": false,
              "properties": {
                "presets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/preset"
                  }
                }
              }
            }
          }
        },
        "overcal:themes": {
          "type": "object",
          "required": [
            "state",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "number"
            },
            "state": {
              "type": "object",
              "required": [
                "customThemes"
              ],
              "additionalProperties": false,
              "properties": {
                "customThemes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/theme"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "displayStyle": {
      "enum": [
        "text",
        "avatar-tr",
        "avatar-bl",
        "avatar-br",
        "block",
        "background",
        "border-top",
        "border-bottom"
      ]
    },
    "eventType": {
      "type": "object",
      "required": [
        "id",
        "label",
        "color",
        "icon",
        "allDayStyle",
        "timedStyle"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "badgeLetter": {
          "type": "boolean"
        },
        "allDayStyle": {
          "$ref": "#/$defs/displayStyle"
        },
        "timedStyle": {
          "$ref": "#/$defs/displayStyle"
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "matchType",
        "matchValue",
        "displayTypeId"
      ],
      "additionalProperties": false,
      "properties": {
        "matchType": {
          "enum": [
            "name",
            "source"
          ]
        },
        "matchValue": {
          "type": "string",
          "minLength": 1
        },
        "displayTypeId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "name",
        "connections",
        "eventTypes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "connections": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Connection id → hidden."
        },
        "eventTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Event type id → hidden."
        },
        "themeId": {
          "type": "string"
        }
      }
    },
    "theme": {
      "type": "object",
      "required": [
        "id",
        "name",
        "mode",
        "accent"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "mode": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fontFamily": {
          "type": "string",
          "description": "A Google Fonts family offered by src/lib/google-fonts.ts."
        },
        "radius": {
          "enum": [
            "0rem",
            "0.375rem",
            "0.75rem"
          ]
        },
        "pattern": {
          "$ref": "#/$defs/pattern"
        }
      }
    },
    "pattern": {
      "enum": [
        "none",
        "dots",
        "grid",
        "diagonal",
        "ruled"
      ]
    }
  }
}
